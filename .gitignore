# Upstream clones. Re-created by bin/provision.sh from versions.lock -- these are
# 1.2 GB of other people's code, pinned to exact SHAs, and gitignoring the
# directories outright means git never even descends into them.
/repos/

# Toolchain: Temurin JDK 17 + Maven, ~337 MB, re-downloadable from versions.lock
# with checksum verification.
/runtime/

# Runtime state. logs/ and pids/ are written by up.sh; state/ holds demo
# by-products from demo.sh.
/logs/
/pids/
/state/

# The e2e PNGs ARE committed -- they are the only artefact of a browser-driven
# claim, and e2e-browser.py clears this directory on every run so a committed set
# is always one coherent pass. The generated diagnostics beside them are not.
docs/screenshots/e2e/*.html
docs/screenshots/e2e/*.json
docs/screenshots/e2e/*.txt

# Belt and braces. Everything these would match today is already excluded above,
# but they are exactly what gets staged by accident when up.sh is run from
# inside a clone.
node_modules/
build/
dist/
.gradle/
*.class
# Python bytecode: bin/e2e-browser.py is run from the repo root, so a stray
# py_compile or an editor's indexer drops this next to the script.
__pycache__/
*.pyc

# The Playwright virtualenv that README tells you to create for
# bin/e2e-browser.py (Ubuntu 24.04 is PEP-668 "externally managed", so Playwright
# cannot be pip-installed into the system interpreter).
.venv/

# CI harness (executed by bin/ci-local.sh)
.ci-local/

# Working docs kept locally but deliberately not published with the repo.
# They are the author's private runbook and planning notes, not part of the
# public deliverable; the local copies stay, but they must never be staged.
/CONTRIBUTING.md
/GIT-PLAN.md
/IRIS-LXC-PLAN.md
/LXC-DROPIN.md
/PLAN.md
/SESSION-NOTES.md
/TEST-FLOW.md
/investigation-log.md
/blog/
