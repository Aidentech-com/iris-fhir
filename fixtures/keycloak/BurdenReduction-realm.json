    { "name": "patient/Patient.read",             "protocol": "openid-connect" },
    { "name": "patient/Patient.write",            "protocol": "openid-connect" },
    { "name": "patient/Coverage.read",            "protocol": "openid-connect" },
    { "name": "patient/Condition.read",           "protocol": "openid-connect" },
    { "name": "patient/Encounter.read",           "protocol": "openid-connect" },
    { "name": "patient/MedicationRequest.read",   "protocol": "openid-connect" },
    { "name": "patient/QuestionnaireResponse.read","protocol": "openid-connect" },
    { "name": "patient/DeviceRequest.read",       "protocol": "openid-connect" },
    { "name": "patient/Encounter.write",          "protocol": "openid-connect" },
    { "name": "patient/MedicationRequest.write",  "protocol": "openid-connect" }
