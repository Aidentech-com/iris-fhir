        "http://10.0.3.108:3005/*",
        "http://10.0.3.108:8080/test-ehr/*"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
